{{define "content"}}
<div class="container container-md">
<header class="page-header"><h1 class="page-title">{{t .Lang "help.title"}}</h1><p class="page-lead">{{t .Lang "help.description"}}</p></header>
<section class="section-card" aria-labelledby="getting-started"><h2 id="getting-started">{{t .Lang "help.getting_started"}}</h2><ul><li><a href="{{path "/search"}}">{{t .Lang "common.search"}}</a></li><li><a href="{{path "/list"}}">{{t .Lang "nav.all_templates"}}</a></li><li><a href="{{path "/categories"}}">{{t .Lang "nav.categories"}}</a></li><li><a href="{{path "/combine"}}">{{t .Lang "nav.combine"}}</a></li></ul></section>
<section class="section-card" aria-labelledby="api-documentation"><h2 id="api-documentation">{{t .Lang "help.api_documentation"}}</h2><p><a href="{{path "/docs"}}">{{t .Lang "nav.api_docs"}}</a></p><p><a href="{{path "/server/docs/swagger"}}">{{t .Lang "help.swagger_description"}}</a></p><p><a href="{{path "/server/docs/graphql"}}">{{t .Lang "help.graphql_description"}}</a></p></section>
{{if and .TorEnabled .TorRunning .OnionAddress}}<section id="tor-access" class="section-card" aria-labelledby="tor-access-heading"><h2 id="tor-access-heading">{{t .Lang "help.tor_access"}}</h2><p>{{t .Lang "help.tor_summary"}}</p><h3>{{t .Lang "help.onion_address"}}</h3><div class="code-block"><code id="help-onion-address" class="code-content onion-address">{{.OnionAddress}}</code><button class="btn copy-btn" type="button" aria-live="polite" aria-label="{{t .Lang "common.copy_to_clipboard"}}" data-copy="help-onion-address" data-copied-label="{{t .Lang "common.copied"}}">{{t .Lang "common.copy"}}</button></div><h3>{{t .Lang "help.how_to_connect"}}</h3><ol><li><a href="https://www.torproject.org/download/" target="_blank" rel="noopener noreferrer">{{t .Lang "help.download_tor"}}</a></li><li>{{t .Lang "help.open_tor"}}</li><li>{{t .Lang "help.paste_onion"}}</li></ol><p>{{t .Lang "help.tor_privacy"}}</p></section>{{end}}
{{if and .I2PEnabled .I2PRunning .I2PAddress}}<section id="i2p-access" class="section-card" aria-labelledby="i2p-access-heading"><h2 id="i2p-access-heading">{{t .Lang "help.i2p_access"}}</h2><p>{{t .Lang "help.i2p_summary"}}</p><h3>{{t .Lang "help.i2p_address"}}</h3><div class="code-block"><code id="help-i2p-address" class="code-content i2p-address">{{.I2PAddress}}</code><button class="btn copy-btn" type="button" aria-live="polite" aria-label="{{t .Lang "common.copy_to_clipboard"}}" data-copy="help-i2p-address" data-copied-label="{{t .Lang "common.copied"}}">{{t .Lang "common.copy"}}</button></div><h3>{{t .Lang "help.i2p_how_to_connect"}}</h3><ol><li>{{t .Lang "help.i2p_install"}} <a href="https://geti2p.net/en/download" target="_blank" rel="noopener noreferrer">{{t .Lang "help.i2p_download"}}</a> <span aria-hidden="true">·</span> <a href="https://i2pd.website/" target="_blank" rel="noopener noreferrer">{{t .Lang "help.i2pd_download"}}</a></li><li>{{t .Lang "help.i2p_proxy"}}</li><li>{{t .Lang "help.i2p_paste"}}</li></ol><p>{{t .Lang "help.i2p_privacy"}}</p></section>{{end}}
<section class="section-card" aria-labelledby="troubleshooting"><h2 id="troubleshooting">{{t .Lang "help.troubleshooting"}}</h2><p><a href="{{path "/server/healthz"}}">/server/healthz</a></p></section>
{{if .Data.project}}<section class="section-card" aria-labelledby="project-help"><h2 id="project-help">{{t .Lang "help.features"}}</h2><p>{{.Data.project}}</p></section>{{end}}
<section class="section-card" aria-labelledby="more-help"><h2 id="more-help">{{t .Lang "help.more"}}</h2><ul class="hub-list">{{range .Data.registeredPages}}<li class="hub-item"><a class="hub-link" href="{{path .Path}}"><span class="hub-title">{{.Title}}</span><span class="hub-desc">{{.Description}}</span></a></li>{{end}}</ul></section>
</div>
{{end}}
