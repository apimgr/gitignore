{{define "content"}}
<div class="container container-sm">
<header class="page-header"><nav class="breadcrumb" aria-label="{{t .Lang "a11y.breadcrumb"}}"><a href="{{path "/server/security"}}">{{t .Lang "security_page.back"}}</a></nav><h1 class="page-title">{{t .Lang "security_page.report_status_title"}}</h1><p class="page-lead">{{t .Lang "security_page.report_status_description"}}</p></header>
<section class="section-card" aria-labelledby="report-status">
<h2 id="report-status">{{t .Lang "nav.status"}}</h2>
<p>{{tf .Lang "web.security_status.tracking_id" "id" .Data.trackingID}}</p>
<p>{{.Data.status}}</p>
{{if .Data.comment}}<p>{{.Data.comment}}</p>{{end}}
{{if .Data.disclosureDate}}<p>{{tf .Lang "web.security_status.disclosure_date" "date" .Data.disclosureDate}}</p>{{end}}
<p>{{t .Lang "web.security_status.access_frequency"}}</p>
</section>
</div>
{{end}}
