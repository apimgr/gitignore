{{define "content"}}
<div class="container container-md">
<header class="page-header"><h1 class="page-title">{{t .Lang "security_page.title"}}</h1><p class="page-lead">{{t .Lang "security_page.description"}}</p></header>
<section class="section-card" aria-labelledby="report-vulnerability">
<h2 id="report-vulnerability">{{t .Lang "web.security.report"}}</h2>
<ol>
{{if not .Data.torRequest}}<li><a href="https://github.com/apimgr/gitignore/security/advisories/new" rel="noopener noreferrer">{{t .Lang "web.security.github_private_reporting"}}</a></li>{{end}}
<li><a href="{{.Data.reportURL}}">{{t .Lang "web.security.deployed_report"}}</a></li>
<li>{{tf .Lang "web.security.email_report" "email" .Data.email}}</li>
</ol>
<p>{{t .Lang "web.security.no_public_issue"}} <a href="{{path "/server/security/policy"}}">{{t .Lang "web.security.policy_link_sentence"}}</a></p>
</section>
<section class="section-card" aria-labelledby="security-contact">
<h2 id="security-contact">{{t .Lang "web.security.contact"}}</h2>
<p>{{tf .Lang "web.security.contact_file" "path" "/.well-known/security.txt" "expires" .Data.expires}}</p>
{{if .Data.pgpAvailable}}<p>{{tf .Lang "web.security.public_key" "url" "/.well-known/pgp-key.asc" "fingerprint" .Data.pgpFingerprint}}</p>{{end}}
<p><a href="{{path "/server/security/thanks"}}">{{t .Lang "security_page.thanks_title"}}</a>.</p>
</section>
</div>
{{end}}
