{{define "content"}}
<h1>{{t .Lang "web.home.title"}}</h1>
<p>{{.Description}} {{t .Lang "web.home.description"}}</p>
<form action="{{path "/search"}}" method="get">
<input type="text" name="q" placeholder="{{t .Lang "web.home.search_placeholder"}}" aria-label="{{t .Lang "common.search"}}">
<button type="submit">{{t .Lang "common.search"}}</button>
</form>
<p>{{tf .Lang "web.home.catalog_summary" "templates" .Data.total "categories" .Data.categories}}</p>
<h2>{{t .Lang "web.home.quick_start"}}</h2>
<pre>curl {{.BaseURL}}{{.APIBase}}/templates/go
curl {{.BaseURL}}{{.APIBase}}/combine?templates=go,node,macos</pre>
{{end}}
